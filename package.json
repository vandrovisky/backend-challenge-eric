{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch run src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/unit",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test --timeout 90000 test/integration",
    "infra:up": "docker compose up -d postgres localstack",
    "infra:down": "docker compose down -v",
    "db:migrate": "bun run scripts/migrate.ts up",
    "db:migrate:down": "bun run scripts/migrate.ts down",
    "db:migrate:status": "bun run scripts/migrate.ts status",
    "app:up": "docker compose --profile app up -d --build",
    "app:down": "docker compose --profile app down -v",
    "queue:send": "bun run scripts/send-wager-message.ts",
    "test:load": "bun run scripts/load-test.ts",
    "test:all": "bun test --timeout 180000 test/unit test/integration"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1159.0",
    "@mikro-orm/core": "^7.2.5",
    "@mikro-orm/migrations": "^7.2.5",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.5",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "12.0.5",
    "decimal.js": "^10.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.6",
    "typescript": "^7.0.2"
  }
}
